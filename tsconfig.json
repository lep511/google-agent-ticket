{
  "compilerOptions": {
    "target": "ES2022",
    // TypeScript 7 defaults `strict` to true; the project never ran under strict
    // mode, so the previous behaviour is kept explicit. Enabling it surfaces nine
    // errors (server.ts, src/ReportTemplate.tsx, src/main.tsx) to fix first.
    "strict": false,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "old_version"
  ]
}