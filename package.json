{
  "name": "tickr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "build:vercel": "vite build",
    "test": "vitest --run",
    "test:essential": "vitest --run --project server --project web",
    "test:non-essential": "vitest --run --project server-slow --project web-slow",
    "test:watch": "vitest --project server --project web"
  },
  "dependencies": {
    "@strands-agents/sdk": "1.11.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "amazon-cognito-identity-js": "^6.3.20",
    "archiver": "^8.0.0",
    "aws-jwt-verify": "^5.2.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^6.49.0",
    "pako": "^2.1.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "vite": "^6.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/archiver": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.14.0",
    "@types/pako": "^2.0.4",
    "autoprefixer": "^10.4.21",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "undici": "^7.29.0",
    "@strands-agents/sdk": {
      "express": "$express"
    }
  },
  "allowScripts": {
    "esbuild": true
  }
}
