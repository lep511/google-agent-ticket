{
  "name": "tickr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "build:vercel": "vite build",
    "test": "vitest --run",
    "test:essential": "vitest --run --project server --project web",
    "test:non-essential": "vitest --run --project server-slow --project web-slow",
    "test:watch": "vitest --project server --project web"
  },
  "dependencies": {
    "@strands-agents/sdk": "1.21.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "amazon-cognito-identity-js": "^6.3.22",
    "archiver": "^8.0.0",
    "aws-jwt-verify": "^5.2.1",
    "dotenv": "^18.0.8",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.57.0",
    "motion": "^14.3.0",
    "openai": "^6.49.0",
    "pako": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "vite": "^8.3.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.19.2",
    "@types/pako": "^2.0.4",
    "@vercel/functions": "^3.10.1",
    "autoprefixer": "^10.6.1",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "uuid": "^14.0.2",
    "undici": "^8.12.1",
    "@strands-agents/sdk": {
      "express": "$express"
    },
    "postcss-selector-parser": "^7.1.6"
  },
  "allowScripts": {
    "esbuild": true
  }
}
