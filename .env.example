VITE_COGNITO_USER_POOL_ID=us-east-1_exampleId
VITE_COGNITO_CLIENT_ID=exampleAppClientId123456
VITE_COGNITO_REGION=us-east-1

# Cognito Domain - Accepts multiple formats:
# Option 1 (Full URL): https://your-domain.auth.us-east-1.amazoncognito.com
# Option 2 (Domain with suffix): your-domain.auth.us-east-1.amazoncognito.com
# Option 3 (Domain prefix only): your-domain
VITE_COGNITO_DOMAIN=your-cognito-domain

# Required for AI analysis functionality
GEMINI_API_KEY=your_gemini_api_key_here

# Model the agents run on. The request may also carry a `model` field, which wins
# over this value. Use a Gemini 3.x model: 2.5 rejects the tool-call ids the
# provider replays, so multi-step runs fail against it.
GEMINI_MODEL_ID=gemini-3.6-flash

# Model behind the `google_search` tool. Its calls are single grounded lookups,
# so a cheaper model than the agent loop is usually the right trade.
GEMINI_SEARCH_MODEL_ID=gemini-2.5-flash

# Model used by POST /api/tts for narration.
GEMINI_TTS_MODEL_ID=gemini-3.1-flash-tts-preview

# Bind address of the Express server. Defaults to 127.0.0.1, which is reachable
# only from this machine. Any other address (0.0.0.0, a LAN IP, ...) is refused
# unless API_ACCESS_TOKEN is set, and then every /api/*, /artifacts and
# /run_logs request must carry `Authorization: Bearer <API_ACCESS_TOKEN>`.
HOST=127.0.0.1

# Shared secret required when HOST is not loopback. At least 32 characters.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
API_ACCESS_TOKEN=
